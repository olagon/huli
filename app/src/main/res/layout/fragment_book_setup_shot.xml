<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/book_preview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/book_setup_shot_buttons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/book_still"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitCenter"
        android:visibility="gone"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="@id/book_preview"
        app:layout_constraintBottom_toBottomOf="@id/book_preview"
        app:layout_constraintStart_toStartOf="@id/book_preview"
        app:layout_constraintEnd_toEndOf="@id/book_preview" />

    <de.schliweb.makeacopy.bookmode.capture.PageAreaView
        android:id="@+id/book_page_area"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/book_preview"
        app:layout_constraintBottom_toBottomOf="@id/book_preview"
        app:layout_constraintStart_toStartOf="@id/book_preview"
        app:layout_constraintEnd_toEndOf="@id/book_preview" />

    <TextView
        android:id="@+id/book_setup_instructions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="#99000000"
        android:padding="8dp"
        android:textColor="@android:color/white"
        android:text="@string/book_setup_instructions"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/book_warp_thumb"
        android:layout_width="110dp"
        android:layout_height="150dp"
        android:layout_margin="12dp"
        android:background="#99000000"
        android:scaleType="fitCenter"
        android:visibility="gone"
        android:contentDescription="@null"
        app:layout_constraintBottom_toTopOf="@id/book_setup_shot_buttons"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/book_setup_shot_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="8dp"
        android:background="#CC000000"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/button_book_detect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/book_detect_page" />

        <Button
            android:id="@+id/button_book_rotate"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@android:color/white"
            android:visibility="gone"
            android:text="@string/book_rotate" />

        <Button
            android:id="@+id/button_book_confirm_area"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:visibility="gone"
            android:text="@string/book_confirm_area" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
