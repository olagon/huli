<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <include layout="@layout/view_book_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorPrimaryContainer"
                app:strokeWidth="0dp"
                xmlns:app="http://schemas.android.com/apk/res-auto">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">

                    <ImageView
                        android:id="@+id/book_cover_preview"
                        android:layout_width="54dp"
                        android:layout_height="74dp"
                        android:layout_marginEnd="12dp"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/title_scan_card_title"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            android:textAppearance="?attr/textAppearanceTitleSmall" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/title_scan_card_body"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            android:textAppearance="?attr/textAppearanceBodySmall" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/button_scan_title_page"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/title_scan_open" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/book_storage_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@android:color/holo_red_dark"
                android:visibility="gone" />

            <EditText
                android:id="@+id/book_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/book_title_hint"
                android:inputType="textCapWords"
                android:importantForAutofill="no" />

            <EditText
                android:id="@+id/book_author"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/book_author_hint"
                android:inputType="textCapWords"
                android:importantForAutofill="no" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/book_language"
                android:textAppearance="?attr/textAppearanceTitleSmall" />

            <RadioGroup
                android:id="@+id/book_language_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checkedButton="@+id/book_lang_both">

                <RadioButton
                    android:id="@+id/book_lang_eng"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/book_lang_eng" />

                <RadioButton
                    android:id="@+id/book_lang_haw"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/book_lang_haw" />

                <RadioButton
                    android:id="@+id/book_lang_both"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/book_lang_both" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/book_diacritics"
                android:textAppearance="?attr/textAppearanceTitleSmall" />

            <RadioGroup
                android:id="@+id/book_diacritics_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checkedButton="@+id/book_diac_unsure">

                <RadioButton
                    android:id="@+id/book_diac_with"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/book_diac_with" />

                <RadioButton
                    android:id="@+id/book_diac_without"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/book_diac_without" />

                <RadioButton
                    android:id="@+id/book_diac_unsure"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/book_diac_unsure" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/book_layout"
                android:textAppearance="?attr/textAppearanceTitleSmall" />

            <RadioGroup
                android:id="@+id/book_layout_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checkedButton="@+id/book_layout_single">

                <RadioButton
                    android:id="@+id/book_layout_single"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/book_layout_single" />

                <RadioButton
                    android:id="@+id/book_layout_spread"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/book_layout_spread" />
            </RadioGroup>

            <CheckBox
                android:id="@+id/book_first_right_only"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:text="@string/book_first_right_only" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/book_dewarp"
                android:textAppearance="?attr/textAppearanceTitleSmall" />

            <RadioGroup
                android:id="@+id/book_dewarp_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checkedButton="@+id/book_dewarp_auto">

                <RadioButton
                    android:id="@+id/book_dewarp_auto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/book_dewarp_auto" />

                <RadioButton
                    android:id="@+id/book_dewarp_off"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/book_dewarp_off" />
            </RadioGroup>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/book_setup_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="12dp">

        <Button
            android:id="@+id/button_book_setup_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/book_next_setup" />
    </LinearLayout>
</LinearLayout>
