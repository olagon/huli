<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <include layout="@layout/view_book_toolbar" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/viewer_mode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        app:checkedButton="@+id/viewer_mode_text"
        app:selectionRequired="true"
        app:singleSelection="true">

        <Button
            android:id="@+id/viewer_mode_text"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="120dp"
            android:text="@string/viewer_mode_text" />

        <Button
            android:id="@+id/viewer_mode_image"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="120dp"
            android:text="@string/viewer_mode_image" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:text="@string/viewer_hint"
        android:textAppearance="?attr/textAppearanceBodySmall" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/viewer_text_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/viewer_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:lineSpacingMultiplier="1.35"
                android:textSize="18sp"
                android:textColor="?attr/colorOnSurface" />
        </ScrollView>

        <de.schliweb.makeacopy.bookmode.ui.ZoomImageView
            android:id="@+id/viewer_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#14000000"
            android:contentDescription="@null"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp">

        <Button
            android:id="@+id/viewer_prev"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/viewer_prev" />

        <TextView
            android:id="@+id/viewer_position"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceLabelLarge" />

        <Button
            android:id="@+id/viewer_next"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/viewer_next" />
    </LinearLayout>
</LinearLayout>
